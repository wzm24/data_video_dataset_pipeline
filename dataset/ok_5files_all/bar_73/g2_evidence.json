    "total_of": "unknown",
    "total": 100.0,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "A total or percentage scale must show Filler at 82% and Actual content at 18% of the combined total."
