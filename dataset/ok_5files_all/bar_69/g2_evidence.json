   "required_candidate": true,
   "evidence_type": "pair_ratio",
   "requires": [
    "mark:European Union @ 540.0",
    "mark:China @ 780.0"
   ],
   "assertion": {
    "greater": "European Union @ 540.0",
    "lesser": "China @ 780.0",
    "expected_ratio": 1.3051,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "route_note": "geometry requires the two marks to share a zero baseline; a truncated axis fails geometry but may still pass by label",
   "needs_review": false,
   "visual_evidence_rule_original": "EU bar/label must be 15.4 and visibly taller than China's 11.8; EU should appear second in the order."
