      "value": 18.5
     },
     {
      "mark": "European Union @ 540.0",
      "value": 15.4
     },
     {
      "mark": "China @ 780.0",
      "value": 11.8
     },
     {
      "mark": "Japan @ 1020.0",
      "value": 4.8
     }
    ],
    "direction": "decreasing",
    "strict": true,
    "tolerance": 0.02
   },
   "routes": [
    "geometry"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "The chart must show a descending order by bar height or an explicit ranked list: USA tallest, EU second, China third, Japan shortest."
  },
  {
   "unit_id": "U2",
   "unit_kind": "key_value_extreme",
   "required_candidate": true,
   "evidence_type": "extreme_mark",
   "requires": [
    "all marks of the compared set visible"
   ],
   "assertion": {
    "mark": "USA @ 300.0",
    "extreme": "max",
    "expected": 18.5,
    "compared_set": "whole table",
    "tolerance": 0.02
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
