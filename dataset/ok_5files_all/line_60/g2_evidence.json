{
 "clip_id": "line_60",
 "family": "line",
 "chart_form": "line/multi_line",
 "measure": "mark_height",
 "policy": {
  "ratio_tolerance": 0.05,
  "value_tolerance": 0.02,
  "measured_from": "data_table + chart_spec (not from our svg)"
 },
 "evidence": [
  {
   "unit_id": "U1",
   "unit_kind": "comparison",
   "required_candidate": true,
   "evidence_type": "pair_ratio",
   "requires": [
    "mark:oppose same-sex marriage @ 2003",
    "mark:favor same-sex marriage @ 2003"
   ],
   "assertion": {
    "greater": "oppose same-sex marriage @ 2003",
    "lesser": "favor same-sex marriage @ 2003",
    "expected_ratio": 1.6765,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "route_note": "geometry requires the two marks to share a zero baseline; a truncated axis fails geometry but may still pass by label",
   "needs_review": false,
   "visual_evidence_rule_original": "Both entity series must be visible over time, and at 2003 the oppose series must be above the favor series."
  },
  {
   "unit_id": "U2",
   "unit_kind": "change_or_rate",
   "required_candidate": true,
   "evidence_type": "endpoint_change",
   "requires": [
    "mark:oppose same-sex marriage @ 2003",
    "mark:oppose same-sex marriage @ 2017"
   ],
   "assertion": {
    "low": "oppose same-sex marriage @ 2017",
    "low_value": 32.0,
    "high": "oppose same-sex marriage @ 2003",
    "high_value": 57.0,
    "delta": 25.0,
    "ratio": 1.7812,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "The oppose series must be visible from 2003 to 2017 and show a downward trend."
  },
  {
   "unit_id": "U3",
   "unit_kind": "change_or_rate",
   "required_candidate": true,
   "evidence_type": "endpoint_change",
   "requires": [
    "mark:favor same-sex marriage @ 2003",
    "mark:favor same-sex marriage @ 2017"
   ],
   "assertion": {
    "low": "favor same-sex marriage @ 2003",
    "low_value": 34.0,
    "high": "favor same-sex marriage @ 2017",
    "high_value": 62.0,
    "delta": 28.0,
    "ratio": 1.8235,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "The favor series must be visible from 2003 to 2017 and show an upward trend."
  },
  {
