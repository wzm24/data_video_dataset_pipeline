    "above": "favor same-sex marriage",
    "above_value": 49.0,
    "below": "oppose same-sex marriage",
    "below_value": 49.0,
    "direction": "above at this x",
    "tolerance": 0.02
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "The chart must show the two series meeting at 2011 (both 49) and the favor series above the oppose series at 2013."
  },
  {
   "unit_id": "U5",
   "unit_kind": "key_value_endpoint",
   "required_candidate": true,
   "evidence_type": "value_at_mark",
   "requires": [
