   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "The 'Too much' slice/bar must be visibly labeled 61% and be the largest substantive response slice."
  },
  {
   "unit_id": "U2",
   "unit_kind": "threshold_or_crossing",
   "required_candidate": true,
   "evidence_type": "value_threshold",
   "requires": [
    "mark:Too much @ slice-1"
   ],
   "assertion": {
    "series": "Too much",
    "values": [
     61.0
    ],
    "threshold_between": [
     61.0,
     61.0
    ],
    "tolerance": 0.02
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "The chart must frame 'Too much' as the majority/more-than-half response, not merely as one slice among three."
  },
  {
   "unit_id": "U3",
   "unit_kind": "key_value_endpoint",
   "required_candidate": false,
   "evidence_type": "value_at_mark",
   "requires": [
    "mark:The right amount @ slice-3"
   ],
   "assertion": {
    "mark": "The right amount @ slice-3",
    "field": "value",
    "expected": 23.0,
    "tolerance": 0.02
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "The 'The right amount' slice must show 23% and be labeled as about a quarter if the narration references it."
  },
  {
   "unit_id": "U4",
   "unit_kind": "comparison",
   "required_candidate": false,
   "evidence_type": "pair_ratio",
   "requires": [
    "mark:The right amount @ slice-3",
    "mark:Too little @ slice-4"
   ],
   "assertion": {
    "greater": "The right amount @ slice-3",
    "lesser": "Too little @ slice-4",
    "expected_ratio": 1.7692,
    "tolerance": 0.05
   },
   "routes": [
