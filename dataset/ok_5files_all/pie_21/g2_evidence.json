    "label"
   ],
   "route_note": "geometry requires the two marks to share a zero baseline; a truncated axis fails geometry but may still pass by label",
   "needs_review": false,
   "visual_evidence_rule_original": "Both the 'Too little' 13% slice and the 'The right amount' 23% slice must be visible if this comparison is made."
