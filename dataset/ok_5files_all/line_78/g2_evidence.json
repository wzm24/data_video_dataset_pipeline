{
 "clip_id": "line_78",
 "family": "line",
 "chart_form": "line/single_line",
 "measure": "mark_height",
 "policy": {
  "ratio_tolerance": 0.05,
  "value_tolerance": 0.02,
  "measured_from": "data_table + chart_spec (not from our svg)"
 },
 "evidence": [
  {
   "unit_id": "U1",
   "unit_kind": "identity_or_series",
   "required_candidate": true,
   "evidence_type": "series_identity",
   "requires": [
    "legend or series names visible"
   ],
   "assertion": {
    "series_count": 1,
    "category_count": null,
    "tolerance": 0
   },
   "routes": [
    "structure"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "The Mar 2020 and Mar 2021 endpoints must be identifiable as parts of one continuous oxygen-need series."
  },
  {
   "unit_id": "U2",
   "unit_kind": "key_value_extreme",
   "required_candidate": true,
   "evidence_type": "extreme_mark",
   "requires": [
    "all marks of the compared set visible"
   ],
   "assertion": {
    "mark": "oxygen need @ Mar 2021",
    "extreme": "max",
    "expected": 10501155.4015,
    "compared_set": "whole table",
    "tolerance": 0.02
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "The Mar 2021 mark or label must be present and identifiable as the series maximum."
  },
  {
   "unit_id": "U3",
   "unit_kind": "change_or_rate",
   "required_candidate": true,
   "evidence_type": "endpoint_change",
   "requires": [
    "mark:oxygen need @ Feb 2021",
    "mark:oxygen need @ Mar 2021"
   ],
   "assertion": {
    "low": "oxygen need @ Feb 2021",
    "low_value": 1500577.7008,
    "high": "oxygen need @ Mar 2021",
    "high_value": 10501155.4015,
    "delta": 9000577.7007,
    "ratio": 6.9981,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "Both the Feb 2021 and Mar 2021 values must be visible or readable enough to compare the final month-over-month jump."
  },
  {
   "unit_id": "U4",
   "unit_kind": "comparison",
   "required_candidate": false,
   "evidence_type": "pair_ratio",
   "requires": [
    "mark:oxygen need @ Mar 2021",
    "mark:oxygen need @ Sep 2020"
   ],
   "assertion": {
    "greater": "oxygen need @ Mar 2021",
    "lesser": "oxygen need @ Sep 2020",
    "expected_ratio": 2.3327,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "route_note": "geometry requires the two marks to share a zero baseline; a truncated axis fails geometry but may still pass by label",
   "needs_review": false,
   "visual_evidence_rule_original": "Both the Sep 2020 pre-2021 high and the Mar 2021 final value must be identifiable for the comparison."
  },
  {
   "unit_id": "U5",
   "unit_kind": "trend_or_order",
   "required_candidate": false,
   "evidence_type": "monotonic_order",
   "requires": [
    "mark:oxygen need @ Mar 2020",
    "mark:oxygen need @ Sep 2020",
    "mark:oxygen need @ Feb 2021"
   ],
   "assertion": {
    "sequence": [
     {
      "mark": "oxygen need @ Mar 2020",
      "value": 200751.011
     },
     {
      "mark": "oxygen need @ Sep 2020",
      "value": 4501733.1023
     },
     {
      "mark": "oxygen need @ Feb 2021",
      "value": 1500577.7008
     }
    ],
    "direction": "increasing",
    "strict": true,
    "tolerance": 0.02
   },
   "routes": [
    "geometry"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "The series must show a local high around Sep 2020 and lower values before the final Mar 2021 surge."
  }
 ]
}