{
 "clip_id": "line_25",
 "family": "line",
 "chart_form": "line/multi_line",
 "measure": "mark_height",
 "policy": {
  "ratio_tolerance": 0.05,
  "value_tolerance": 0.02,
  "measured_from": "data_table + chart_spec (not from our svg)"
 },
 "evidence": [
  {
   "unit_id": "U1",
   "unit_kind": "identity_or_series",
   "required_candidate": true,
   "evidence_type": "series_identity",
   "requires": [
    "legend or series names visible"
   ],
   "assertion": {
    "series_count": 2,
    "category_count": null,
    "tolerance": 0
   },
   "routes": [
    "structure"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "Both entity series must be identifiable and matchable to their data paths."
  },
  {
   "unit_id": "U2",
   "unit_kind": "change_or_rate",
   "required_candidate": true,
   "evidence_type": "endpoint_change",
   "requires": [
    "mark:Base Rate Bank of England @ 1991",
    "mark:Base Rate Bank of England @ 2016"
   ],
   "assertion": {
    "low": "Base Rate Bank of England @ 2016",
    "low_value": 0.3991,
    "high": "Base Rate Bank of England @ 1991",
    "high_value": 10.1996,
    "delta": 9.8005,
    "ratio": 25.5565,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "The base-rate path visibly starts high in 1991 and ends low in 2016."
  },
  {
   "unit_id": "U3",
   "unit_kind": "change_or_rate",
   "required_candidate": true,
   "evidence_type": "endpoint_change",
   "requires": [
    "mark:Mortgage rate (Example: 5 year fixed) @ 2016",
    "mark:Mortgage rate (Example: 5 year fixed) @ earliest mortgage-rate point"
   ],
   "assertion": {
    "low": "Mortgage rate (Example: 5 year fixed) @ 2016",
    "low_value": 2.1996,
    "high": "Mortgage rate (Example: 5 year fixed) @ earliest mortgage-rate point",
    "high_value": 9.4989,
    "delta": 7.2993,
    "ratio": 4.3185,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "The mortgage-rate path visibly starts near 9.5% and ends at 2.1996% in 2016."
  },
  {
   "unit_id": "U4",
   "unit_kind": "comparison",
   "required_candidate": false,
   "evidence_type": "pair_ratio",
   "requires": [
    "mark:Mortgage rate (Example: 5 year fixed) @ 2016",
    "mark:Base Rate Bank of England @ 2016"
   ],
   "assertion": {
    "greater": "Mortgage rate (Example: 5 year fixed) @ 2016",
    "lesser": "Base Rate Bank of England @ 2016",
    "expected_ratio": 5.5114,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "route_note": "geometry requires the two marks to share a zero baseline; a truncated axis fails geometry but may still pass by label",
   "needs_review": false,
   "visual_evidence_rule_original": "At the 2016 endpoint, the mortgage-rate path is visibly above the base-rate path."
  },
  {
   "unit_id": "U5",
   "unit_kind": "trend_or_order",
   "required_candidate": true,
   "evidence_type": "monotonic_order",
   "requires": [
    "mark:Base Rate Bank of England @ 2016",
    "mark:Mortgage rate (Example: 5 year fixed) @ 2016",
    "mark:Base Rate Bank of England @ early fluctuation point",
    "mark:Base Rate Bank of England @ later temporary high",
    "mark:Mortgage rate (Example: 5 year fixed) @ early high"
   ],
   "assertion": {
    "sequence": [
     {
      "mark": "Base Rate Bank of England @ 2016",
      "value": 0.3991
     },
     {
      "mark": "Mortgage rate (Example: 5 year fixed) @ 2016",
      "value": 2.1996
     },
     {
      "mark": "Base Rate Bank of England @ early fluctuation point",
      "value": 5.0998
     },
     {
      "mark": "Base Rate Bank of England @ later temporary high",
      "value": 7.4989
     },
     {
      "mark": "Mortgage rate (Example: 5 year fixed) @ early high",
      "value": 8.4989
     }
    ],
    "direction": "increasing",
    "strict": true,
    "tolerance": 0.02
   },
   "routes": [
    "geometry"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "The chart must show an overall downward trajectory with visible fluctuations, not a perfectly smooth monotonic line."
  }
 ]
}