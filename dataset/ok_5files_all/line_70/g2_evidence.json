{
 "clip_id": "line_70",
 "family": "line",
 "chart_form": "line/single_line",
 "measure": "mark_height",
 "policy": {
  "ratio_tolerance": 0.05,
  "value_tolerance": 0.02,
  "measured_from": "data_table + chart_spec (not from our svg)"
 },
 "evidence": [
  {
   "unit_id": "U1",
   "unit_kind": "identity_or_series",
   "required_candidate": true,
   "evidence_type": "series_identity",
   "requires": [
    "legend or series names visible"
   ],
   "assertion": {
    "series_count": 1,
    "category_count": null,
    "tolerance": 0
   },
   "routes": [
    "structure"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "Both 2.4% and 2.3% must be visible as labels or clearly readable point values on the curve."
  },
  {
   "unit_id": "U2",
   "unit_kind": "trend_or_order",
   "required_candidate": true,
   "evidence_type": "monotonic_order",
   "requires": [
    "mark:yield curve @ 0",
    "mark:yield curve @ 1"
   ],
   "assertion": {
    "sequence": [
     {
      "mark": "yield curve @ 0",
      "value": 2.4
     },
     {
      "mark": "yield curve @ 1",
      "value": 2.3
     }
    ],
    "direction": "decreasing",
    "strict": true,
    "tolerance": 0.02
   },
   "routes": [
    "geometry"
   ],
   "needs_review": true,
   "visual_evidence_rule_original": "The first plotted point must appear higher than the second on a common y-axis, or an annotation must show 2.4% moving to 2.3%."
  },
  {
   "unit_id": "U3",
   "unit_kind": "change_or_rate",
   "required_candidate": true,
   "evidence_type": "endpoint_change",
   "requires": [
    "mark:yield curve @ 0",
    "mark:yield curve @ 1"
   ],
   "assertion": {
    "low": "yield curve @ 1",
    "low_value": 2.3,
    "high": "yield curve @ 0",
    "high_value": 2.4,
    "delta": 0.1,
    "ratio": 1.0435,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "A label, annotation, or visually distinct gap must show the 0.1 percentage-point difference between 2.4% and 2.3%."
  },
  {
   "unit_id": "U4",
   "unit_kind": "identity_or_series",
   "required_candidate": true,
   "evidence_type": "series_identity",
   "requires": [
    "legend or series names visible"
   ],
   "assertion": {
    "series_count": 1,
    "category_count": null,
    "tolerance": 0
   },
   "routes": [
    "structure"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "The chart or accompanying text must tie the yield curve to expectations about the economy's direction, not just show a generic rate line."
  }
 ]
}