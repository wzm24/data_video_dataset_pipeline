{
 "clip_id": "donut_16",
 "family": "donut",
 "chart_form": "donut/multi_ring",
 "measure": "sector_angle",
 "policy": {
  "ratio_tolerance": 0.05,
  "value_tolerance": 0.02,
  "measured_from": "data_table + chart_spec (not from our svg)"
 },
 "evidence": [
  {
   "unit_id": "U1",
   "unit_kind": "share_or_composition",
   "required_candidate": true,
   "evidence_type": "sector_or_segment_share",
   "requires": [
    "segment:inner arc @ 0"
   ],
   "assertion": {
    "segment": "inner arc @ 0",
    "expected_share": 0.58,
    "total_of": "percent",
    "total": 100.0,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "The 58% label must be visibly attached to the support/inner arc, not to the opposition arc."
  },
  {
   "unit_id": "U2",
   "unit_kind": "share_or_composition",
   "required_candidate": true,
   "evidence_type": "sector_or_segment_share",
   "requires": [
    "segment:outer arc @ 1"
   ],
   "assertion": {
    "segment": "outer arc @ 1",
    "expected_share": 0.42,
    "total_of": "percent",
    "total": 100.0,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "The 42% label must be visibly attached to the opposition/outer arc, not to the support arc."
  },
  {
   "unit_id": "U3",
   "unit_kind": "comparison",
   "required_candidate": true,
   "evidence_type": "pair_ratio",
   "requires": [
    "mark:inner arc @ 0",
    "mark:outer arc @ 1"
   ],
   "assertion": {
    "greater": "inner arc @ 0",
    "lesser": "outer arc @ 1",
    "expected_ratio": 1.381,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "route_note": "geometry requires the two marks to share a zero baseline; a truncated axis fails geometry but may still pass by label",
   "needs_review": false,
   "visual_evidence_rule_original": "Both arc labels or a comparison annotation must make 58% > 42% visible; the 16-point gap may be shown as a callout."
  },
  {
   "unit_id": "U4",
   "unit_kind": "share_or_composition",
   "required_candidate": false,
   "evidence_type": "sector_or_segment_share",
   "requires": [
    "segment:inner arc @ 0",
    "segment:outer arc @ 1"
   ],
   "assertion": {
    "segment": "inner arc @ 0",
    "expected_share": 0.58,
    "total_of": "percent",
    "total": 100.0,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "The donut must appear complete with exactly two segments whose labels total 100%."
  },
  {
   "unit_id": "U5",
   "unit_kind": "threshold_or_crossing",
   "required_candidate": false,
   "evidence_type": "value_threshold",
   "requires": [
    "mark:inner arc @ 0"
   ],
   "assertion": {
    "series": "inner arc",
    "values": [
     58.0
    ],
    "threshold_between": [
     58.0,
     58.0
    ],
    "tolerance": 0.02
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "If shown, majority status must be tied to the 58% support share, e.g. a 'majority' label, not to the 42% opposition share."
  }
 ]
}