{
 "clip_id": "area_1",
 "family": "area",
 "chart_form": "area/overlay_area",
 "measure": "mark_height",
 "policy": {
  "ratio_tolerance": 0.05,
  "value_tolerance": 0.02,
  "measured_from": "data_table + chart_spec (not from our svg)"
 },
 "evidence": [
  {
   "unit_id": "U1",
   "unit_kind": "threshold_or_crossing",
   "required_candidate": true,
   "evidence_type": "series_crossing",
   "requires": [
    "mark:Infections @ 10",
    "mark:Healthcare capacity @ 10"
   ],
   "assertion": {
    "at": "10",
    "above": "Infections",
    "above_value": 55.8,
    "below": "Healthcare capacity",
    "below_value": 45.0,
    "direction": "above at this x",
    "tolerance": 0.02
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "Both infection and capacity curves must be visible with a marked or visually clear overcapacity interval around x=10 through at least x=37.5."
  },
  {
   "unit_id": "U2",
   "unit_kind": "change_or_rate",
   "required_candidate": true,
   "evidence_type": "endpoint_change",
   "requires": [
    "mark:Healthcare capacity @ 10",
    "mark:Healthcare capacity @ 20",
    "mark:Healthcare capacity @ 37.5",
    "mark:Healthcare capacity @ 55"
   ],
   "assertion": {
    "low": "Healthcare capacity @ 37.5",
    "low_value": 33.0,
    "high": "Healthcare capacity @ 10",
    "high_value": 45.0,
    "delta": 12.0,
    "ratio": 1.3636,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "The capacity line must visibly dip from 45.0 to 33.0 at x=37.5 and show recovery toward 45.0 by x=55."
  },
  {
   "unit_id": "U3",
   "unit_kind": "comparison",
   "required_candidate": true,
   "evidence_type": "pair_ratio",
   "requires": [
    "mark:Infections @ 37.5",
    "mark:Healthcare capacity @ 37.5"
   ],
   "assertion": {
    "greater": "Infections @ 37.5",
    "lesser": "Healthcare capacity @ 37.5",
    "expected_ratio": 2.0364,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "route_note": "geometry requires the two marks to share a zero baseline; a truncated axis fails geometry but may still pass by label",
   "needs_review": false,
   "visual_evidence_rule_original": "The chart must show the infection value and capacity value at x=37.5, or otherwise mark the >2x overcapacity at the capacity minimum."
  },
  {
   "unit_id": "U4",
   "unit_kind": "comparison",
   "required_candidate": true,
   "evidence_type": "pair_ratio",
   "requires": [
    "mark:Infections @ 20",
    "mark:Healthcare capacity @ 20"
   ],
   "assertion": {
    "greater": "Infections @ 20",
    "lesser": "Healthcare capacity @ 20",
    "expected_ratio": 2.0089,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "route_note": "geometry requires the two marks to share a zero baseline; a truncated axis fails geometry but may still pass by label",
   "needs_review": false,
   "visual_evidence_rule_original": "The chart must show the infection curve peaking at 90.4 near x=20-30 against the capacity line at 45.0."
  },
  {
   "unit_id": "U5",
   "unit_kind": "trend_or_order",
   "required_candidate": false,
   "evidence_type": "monotonic_order",
   "requires": [
    "mark:Infections @ 20",
    "mark:Infections @ 30",
    "mark:Infections @ 37.5",
    "mark:Infections @ 45",
    "mark:Infections @ 55"
   ],
   "assertion": {
    "sequence": [
     {
      "mark": "Infections @ 20",
      "value": 90.4
     },
     {
      "mark": "Infections @ 30",
      "value": 90.4
     },
     {
      "mark": "Infections @ 37.5",
      "value": 67.2
     },
     {
      "mark": "Infections @ 45",
      "value": 29.4
     },
     {
      "mark": "Infections @ 55",
      "value": 0.0
     }
    ],
    "direction": "decreasing",
    "strict": true,
    "tolerance": 0.02
   },
   "routes": [
    "geometry"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "The chart must show the post-peak infection decline ending at 0.0 by x=55."
  }
 ]
}