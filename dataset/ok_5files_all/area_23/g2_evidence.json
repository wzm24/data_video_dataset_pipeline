{
 "clip_id": "area_23",
 "family": "area",
 "chart_form": "area/bubble",
 "measure": "mark_height",
 "policy": {
  "ratio_tolerance": 0.05,
  "value_tolerance": 0.02,
  "measured_from": "data_table + chart_spec (not from our svg)"
 },
 "evidence": [
  {
   "unit_id": "U1",
   "unit_kind": "key_value_endpoint",
   "required_candidate": false,
   "evidence_type": "value_at_mark",
   "requires": [
    "mark:Earth @ diameter"
   ],
   "assertion": {
    "mark": "Earth @ diameter",
    "field": "value",
    "expected": 12700.0,
    "tolerance": 0.02
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "Earth's diameter value or a labeled size encoding for Earth must be visible."
  },
  {
   "unit_id": "U2",
   "unit_kind": "key_value_endpoint",
   "required_candidate": false,
   "evidence_type": "value_at_mark",
   "requires": [
    "mark:Moon @ diameter"
   ],
   "assertion": {
    "mark": "Moon @ diameter",
    "field": "value",
    "expected": 3500.0,
    "tolerance": 0.02
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "The Moon's diameter value or a labeled size encoding for the Moon must be visible."
  },
  {
   "unit_id": "U3",
   "unit_kind": "comparison",
   "required_candidate": true,
   "evidence_type": "pair_ratio",
   "requires": [
    "mark:Earth @ diameter",
    "mark:Moon @ diameter"
   ],
   "assertion": {
    "greater": "Earth @ diameter",
    "lesser": "Moon @ diameter",
    "expected_ratio": 3.6286,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "route_note": "geometry requires the two marks to share a zero baseline; a truncated axis fails geometry but may still pass by label",
   "needs_review": false,
   "visual_evidence_rule_original": "The Moon's diameter must be visibly encoded as roughly one-quarter to just over one-quarter of Earth's diameter."
  },
  {
   "unit_id": "U4",
   "unit_kind": "comparison",
   "required_candidate": false,
   "evidence_type": "pair_ratio",
   "requires": [
    "mark:Earth @ diameter",
    "mark:Moon @ diameter"
   ],
   "assertion": {
    "greater": "Earth @ diameter",
    "lesser": "Moon @ diameter",
    "expected_ratio": 3.6286,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "route_note": "geometry requires the two marks to share a zero baseline; a truncated axis fails geometry but may still pass by label",
   "needs_review": false,
   "visual_evidence_rule_original": "Earth's diameter must be visibly encoded as about 3.6 times the Moon's diameter."
  },
  {
   "unit_id": "U5",
   "unit_kind": "threshold_or_crossing",
   "required_candidate": false,
   "evidence_type": "series_crossing",
   "requires": [
    "mark:Earth @ diameter",
    "mark:Moon @ diameter"
   ],
   "assertion": {
    "at": "diameter",
    "above": "Earth",
    "above_value": 12700.0,
    "below": "Moon",
    "below_value": 3500.0,
    "direction": "above at this x",
    "tolerance": 0.02
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "The Moon's diameter must be visibly placed above one-quarter and below one-half of Earth's diameter."
  }
 ]
}