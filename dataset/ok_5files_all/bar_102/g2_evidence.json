   "assertion": {
    "segment": "WeWork @ ratio to top",
    "expected_share": 0.1739,
    "total_of": "unknown",
    "total": 3.2199999999999998,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": true,
