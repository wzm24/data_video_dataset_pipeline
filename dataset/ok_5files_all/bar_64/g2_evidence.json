  {
   "unit_id": "U2",
   "unit_kind": "key_value_endpoint",
   "required_candidate": false,
   "evidence_type": "value_at_mark",
   "requires": [
    "mark:Lactose-Tolerant @ Lactose-Tolerant"
   ],
   "assertion": {
    "mark": "Lactose-Tolerant @ Lactose-Tolerant",
    "field": "value",
    "expected": 35.0,
    "tolerance": 0.02
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "The chart must show the Lactose-Tolerant category with a label, value, or mark at 35% (or the equivalent 0.35 share of the whole)."
