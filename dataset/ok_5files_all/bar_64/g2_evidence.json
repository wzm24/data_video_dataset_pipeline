   "requires": [
    "mark:Lactose Intolerant @ Lactose Intolerant",
    "mark:Lactose-Tolerant @ Lactose-Tolerant"
   ],
   "assertion": {
    "greater": "Lactose Intolerant @ Lactose Intolerant",
    "lesser": "Lactose-Tolerant @ Lactose-Tolerant",
    "expected_ratio": 1.8571,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "route_note": "geometry requires the two marks to share a zero baseline; a truncated axis fails geometry but may still pass by label",
   "needs_review": false,
   "visual_evidence_rule_original": "The chart must allow comparing the two category sizes, e.g., bars with relative lengths or labels showing 65% and 35%."
  },
  {
