{
 "clip_id": "bar_70",
 "family": "bar",
 "chart_form": "bar/simple",
 "measure": "mark_length",
 "policy": {
  "ratio_tolerance": 0.05,
  "value_tolerance": 0.02,
  "measured_from": "data_table + chart_spec (not from our svg)"
 },
 "evidence": [
  {
   "unit_id": "U1",
   "unit_kind": "trend_or_order",
   "required_candidate": true,
   "evidence_type": "monotonic_order",
   "requires": [
    "mark:BILL & MELINDA GATES @ x_value empty",
    "mark:NOVO NORDISK @ x_value empty",
    "mark:STICHTING INGKA @ x_value empty",
    "mark:WELLCOME TRUST @ x_value empty"
   ],
   "assertion": {
    "sequence": [
     {
      "mark": "BILL & MELINDA GATES @ x_value empty",
      "value": 51.6
     },
     {
      "mark": "NOVO NORDISK @ x_value empty",
      "value": 49.1
     },
     {
      "mark": "STICHTING INGKA @ x_value empty",
      "value": 36.0
     },
     {
      "mark": "WELLCOME TRUST @ x_value empty",
      "value": 32.9
     }
    ],
    "direction": "decreasing",
    "strict": true,
    "tolerance": 0.02
   },
   "routes": [
    "geometry"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "Bars or labels must show Stichting Ingka in third position, with two larger values above it and one smaller value below it."
  },
  {
   "unit_id": "U2",
   "unit_kind": "key_value_endpoint",
   "required_candidate": true,
   "evidence_type": "value_at_mark",
   "requires": [
    "mark:STICHTING INGKA @ x_value empty"
   ],
   "assertion": {
    "mark": "STICHTING INGKA @ x_value empty",
    "field": "value",
    "expected": 36.0,
    "tolerance": 0.02
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "Stichting Ingka's bar/endpoint must be labeled 36.0 or 0.6000 relative."
  },
  {
   "unit_id": "U3",
   "unit_kind": "change_or_rate",
   "required_candidate": true,
   "evidence_type": "endpoint_change",
   "requires": [
    "mark:BILL & MELINDA GATES @ x_value empty",
    "mark:STICHTING INGKA @ x_value empty",
    "mark:BILL & MELINDA GATES @ x_value empty",
    "mark:STICHTING INGKA @ x_value empty"
   ],
   "assertion": {
    "low": "STICHTING INGKA @ x_value empty",
    "low_value": 0.6,
    "high": "BILL & MELINDA GATES @ x_value empty",
    "high_value": 51.6,
    "delta": 51.0,
    "ratio": 86.0,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "The visual must compare Gates and Ikea and show or label the roughly 30% smaller gap, not just their absolute bars."
  },
  {
   "unit_id": "U4",
   "unit_kind": "comparison",
   "required_candidate": false,
   "evidence_type": "pair_ratio",
   "requires": [
    "mark:NOVO NORDISK @ x_value empty",
    "mark:STICHTING INGKA @ x_value empty"
   ],
   "assertion": {
    "greater": "NOVO NORDISK @ x_value empty",
    "lesser": "STICHTING INGKA @ x_value empty",
    "expected_ratio": 1.3639,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "route_note": "geometry requires the two marks to share a zero baseline; a truncated axis fails geometry but may still pass by label",
   "needs_review": false,
   "visual_evidence_rule_original": "Novo Nordisk's bar must be visibly taller than Stichting Ingka's, establishing Ikea as third."
  },
  {
   "unit_id": "U5",
   "unit_kind": "comparison",
   "required_candidate": false,
   "evidence_type": "pair_ratio",
   "requires": [
    "mark:STICHTING INGKA @ x_value empty",
    "mark:WELLCOME TRUST @ x_value empty"
   ],
   "assertion": {
    "greater": "STICHTING INGKA @ x_value empty",
    "lesser": "WELLCOME TRUST @ x_value empty",
    "expected_ratio": 1.0942,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "route_note": "geometry requires the two marks to share a zero baseline; a truncated axis fails geometry but may still pass by label",
   "needs_review": false,
   "visual_evidence_rule_original": "Wellcome Trust's bar must be shorter than Stichting Ingka's."
  }
 ]
}