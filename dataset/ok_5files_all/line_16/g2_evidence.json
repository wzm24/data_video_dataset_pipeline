{
 "clip_id": "line_16",
 "family": "line",
 "chart_form": "line/multi_line",
 "measure": "mark_height",
 "policy": {
  "ratio_tolerance": 0.05,
  "value_tolerance": 0.02,
  "measured_from": "data_table + chart_spec (not from our svg)"
 },
 "evidence": [
  {
   "unit_id": "U1",
   "unit_kind": "comparison",
   "required_candidate": true,
   "evidence_type": "pair_ratio",
   "requires": [
    "mark:NO @ 120.0",
    "mark:YES @ 120.0"
   ],
   "assertion": {
    "greater": "NO @ 120.0",
    "lesser": "YES @ 120.0",
    "expected_ratio": 2.0,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "route_note": "geometry requires the two marks to share a zero baseline; a truncated axis fails geometry but may still pass by label",
   "needs_review": false,
   "visual_evidence_rule_original": "Both series shown; NO marks stay above YES at every shared time point."
  },
  {
   "unit_id": "U2",
   "unit_kind": "threshold_or_crossing",
   "required_candidate": true,
   "evidence_type": "series_crossing",
   "requires": [
    "mark:NO @ 670.0",
    "mark:YES @ 670.0"
   ],
   "assertion": {
    "at": "670.0",
    "above": "NO",
    "above_value": 0.7697,
    "below": "YES",
    "below_value": 0.5161,
    "direction": "above at this x",
    "tolerance": 0.02
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "YES peak and NO trough visible; YES stays below NO minimum."
  },
  {
   "unit_id": "U3",
   "unit_kind": "comparison",
   "required_candidate": false,
   "evidence_type": "pair_ratio",
   "requires": [
    "mark:YES @ 120.0",
    "mark:DON'T KNOW @ 303.3"
   ],
   "assertion": {
    "greater": "YES @ 120.0",
    "lesser": "DON'T KNOW @ 303.3",
    "expected_ratio": 3.134,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "route_note": "geometry requires the two marks to share a zero baseline; a truncated axis fails geometry but may still pass by label",
   "needs_review": false,
   "visual_evidence_rule_original": "DON'T KNOW marks stay below both YES and NO series."
  },
  {
   "unit_id": "U4",
   "unit_kind": "trend_or_order",
   "required_candidate": true,
   "evidence_type": "monotonic_order",
   "requires": [
    "mark:YES @ 120.0",
    "mark:YES @ 670.0",
    "mark:YES @ 1220.0"
   ],
   "assertion": {
    "sequence": [
     {
      "mark": "YES @ 120.0",
      "value": 0.4256
     },
     {
      "mark": "YES @ 670.0",
      "value": 0.5161
     },
     {
      "mark": "YES @ 1220.0",
      "value": 0.5071
     }
    ],
    "direction": "increasing",
    "strict": true,
    "tolerance": 0.02
   },
   "routes": [
    "geometry"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "YES series stays within a narrow band across all poll points."
  },
  {
   "unit_id": "U5",
   "unit_kind": "change_or_rate",
   "required_candidate": false,
   "evidence_type": "endpoint_change",
   "requires": [
    "mark:NO @ 120.0",
    "mark:YES @ 120.0",
    "mark:NO @ 670.0",
    "mark:YES @ 670.0"
   ],
   "assertion": {
    "low": "YES @ 120.0",
    "low_value": 0.4256,
    "high": "NO @ 120.0",
    "high_value": 0.8512,
    "delta": 0.4256,
    "ratio": 2.0,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "Distance between NO and YES marks varies across poll points."
  }
 ]
}