    "expected_ratio": 3.8048,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "route_note": "geometry requires the two marks to share a zero baseline; a truncated axis fails geometry but may still pass by label",
   "needs_review": false,
   "visual_evidence_rule_original": "Both 2040 endpoint values, or a final ratio, must be visible so the ~3.8x comparison can be made."
