{
 "clip_id": "line_65",
 "family": "line",
 "chart_form": "line/single_line",
 "measure": "mark_height",
 "policy": {
  "ratio_tolerance": 0.05,
  "value_tolerance": 0.02,
  "measured_from": "data_table + chart_spec (not from our svg)"
 },
 "evidence": [
  {
   "unit_id": "U1",
   "unit_kind": "identity_or_series",
   "required_candidate": true,
   "evidence_type": "series_identity",
   "requires": [
    "legend or series names visible"
   ],
   "assertion": {
    "series_count": 1,
    "category_count": null,
    "tolerance": 0
   },
   "routes": [
    "structure"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "The series must be identifiable as reported cases from its labels or accompanying text."
  },
  {
   "unit_id": "U2",
   "unit_kind": "trend_or_order",
   "required_candidate": true,
   "evidence_type": "monotonic_order",
   "requires": [
    "mark:reported cases @ first row",
    "mark:reported cases @ final row"
   ],
   "assertion": {
    "sequence": [
     {
      "mark": "reported cases @ first row",
      "value": 400000.0
     },
     {
      "mark": "reported cases @ final row",
      "value": 20000.0
     }
    ],
    "direction": "decreasing",
    "strict": true,
    "tolerance": 0.02
   },
   "routes": [
    "geometry"
   ],
   "needs_review": true,
   "visual_evidence_rule_original": "The final plotted value must be visibly much lower than the first plotted value, and the overall trend must read as downward."
  },
  {
   "unit_id": "U3",
   "unit_kind": "key_value_endpoint",
   "required_candidate": true,
   "evidence_type": "value_at_mark",
   "requires": [
    "mark:reported cases @ final row"
   ],
   "assertion": {
    "mark": "reported cases @ final row",
    "field": "value",
    "expected": 20000.0,
    "tolerance": 0.02
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "The last point, or last two points, must be visibly at the lowest level of the series."
  },
  {
   "unit_id": "U4",
   "unit_kind": "key_value_extreme",
   "required_candidate": false,
   "evidence_type": "extreme_mark",
   "requires": [
    "all marks of the compared set visible"
   ],
   "assertion": {
    "mark": "reported cases @ middle row",
    "extreme": "max",
    "expected": 620000.0,
    "compared_set": "whole table",
    "tolerance": 0.02
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "The highest point of the plotted series must be visible and correspond to 620,000."
  },
  {
   "unit_id": "U5",
   "unit_kind": "comparison",
   "required_candidate": false,
   "evidence_type": "pair_ratio",
   "requires": [
    "mark:reported cases @ middle row",
    "mark:reported cases @ final row"
   ],
   "assertion": {
    "greater": "reported cases @ middle row",
    "lesser": "reported cases @ final row",
    "expected_ratio": 31.0,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "route_note": "geometry requires the two marks to share a zero baseline; a truncated axis fails geometry but may still pass by label",
   "needs_review": false,
   "visual_evidence_rule_original": "Both the peak and the final level must be identifiable so their heights can be compared."
  }
 ]
}