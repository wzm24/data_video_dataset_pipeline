{
 "clip_id": "area_39",
 "family": "area",
 "chart_form": "area/bubble",
 "measure": "mark_height",
 "policy": {
  "ratio_tolerance": 0.05,
  "value_tolerance": 0.02,
  "measured_from": "data_table + chart_spec (not from our svg)"
 },
 "evidence": [
  {
   "unit_id": "U1",
   "unit_kind": "identity_or_series",
   "required_candidate": true,
   "evidence_type": "series_identity",
   "requires": [
    "legend or series names visible"
   ],
   "assertion": {
    "series_count": 1,
    "category_count": null,
    "tolerance": 0
   },
   "routes": [
    "structure"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "Three distinct debt values must be identifiable or legible as 10,000, 30,000, and 70,000 USD, or represented as three distinct ordered magnitudes."
  },
  {
   "unit_id": "U2",
   "unit_kind": "trend_or_order",
   "required_candidate": true,
   "evidence_type": "monotonic_order",
   "requires": [
    "mark:student debt @ debt_0",
    "mark:student debt @ debt_1",
    "mark:student debt @ debt_2"
   ],
   "assertion": {
    "sequence": [
     {
      "mark": "student debt @ debt_0",
      "value": 10000.0
     },
     {
      "mark": "student debt @ debt_1",
      "value": 30000.0
     },
     {
      "mark": "student debt @ debt_2",
      "value": 70000.0
     }
    ],
    "direction": "increasing",
    "strict": true,
    "tolerance": 0.02
   },
   "routes": [
    "geometry"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "The 70,000 USD value must correspond to the largest bubble size, the 30,000 USD value to the middle size, and the 10,000 USD value to the smallest size."
  },
  {
   "unit_id": "U3",
   "unit_kind": "key_value_endpoint",
   "required_candidate": false,
   "evidence_type": "value_at_mark",
   "requires": [
    "mark:student debt @ debt_0"
   ],
   "assertion": {
    "mark": "student debt @ debt_0",
    "field": "value",
    "expected": 10000.0,
    "tolerance": 0.02
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "The largest and smallest debt magnitudes must be identifiable, either by labels or by the size extremes."
  },
  {
   "unit_id": "U4",
   "unit_kind": "change_or_rate",
   "required_candidate": false,
   "evidence_type": "endpoint_change",
   "requires": [
    "mark:student debt @ debt_0",
    "mark:student debt @ debt_1",
    "mark:student debt @ debt_2"
   ],
   "assertion": {
    "low": "student debt @ debt_0",
    "low_value": 10000.0,
    "high": "student debt @ debt_2",
    "high_value": 70000.0,
    "delta": 60000.0,
    "ratio": 7.0,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "If ratios are conveyed, the relative sizes must be consistent with 7:3:1 or the stated pairwise ratios and must not contradict the bubble sizes."
  },
  {
   "unit_id": "U5",
   "unit_kind": "share_or_composition",
   "required_candidate": false,
   "evidence_type": "sector_or_segment_share",
   "requires": [
    "segment:student debt @ debt_0",
    "segment:student debt @ debt_1",
    "segment:student debt @ debt_2"
   ],
   "assertion": {
    "segment": "student debt @ debt_0",
    "expected_share": 0.1429,
    "total_of": "usd",
    "total": 70000.0,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": true,
   "visual_evidence_rule_original": "If share is shown, the composition must be over exactly these three displayed debt values totaling 110,000 USD; do not imply it is all student debt or household debt."
