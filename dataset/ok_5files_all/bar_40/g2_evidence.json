{
 "clip_id": "bar_40",
 "family": "bar",
 "chart_form": "bar/simple",
 "measure": "mark_length",
 "policy": {
  "ratio_tolerance": 0.05,
  "value_tolerance": 0.02,
  "measured_from": "data_table + chart_spec (not from our svg)"
 },
 "evidence": [
  {
   "unit_id": "U1",
   "unit_kind": "identity_or_series",
   "required_candidate": true,
   "evidence_type": "series_identity",
   "requires": [
    "legend or series names visible"
   ],
   "assertion": {
    "series_count": 1,
    "category_count": 2,
    "tolerance": 0
   },
   "routes": [
    "structure"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "Narration or on-screen text states same job/income; no bar from the table is required for this context."
  },
  {
   "unit_id": "U2",
   "unit_kind": "key_value_endpoint",
   "required_candidate": true,
   "evidence_type": "value_at_mark",
   "requires": [
    "mark:MY WEALTH"
   ],
   "assertion": {
    "mark": "MY WEALTH",
    "field": "value",
    "expected": 0.373,
    "tolerance": 0.02
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "Two labeled bars are present, with MY WEALTH and FRIEND'S WEALTH values or relative values readable or implied."
  },
  {
   "unit_id": "U3",
   "unit_kind": "comparison",
   "required_candidate": true,
   "evidence_type": "pair_ratio",
   "requires": [
    "mark:FRIEND'S WEALTH",
    "mark:MY WEALTH"
   ],
   "assertion": {
    "greater": "FRIEND'S WEALTH",
    "lesser": "MY WEALTH",
    "expected_ratio": 2.681,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "route_note": "geometry requires the two marks to share a zero baseline; a truncated axis fails geometry but may still pass by label",
   "needs_review": false,
   "visual_evidence_rule_original": "Friend bar is visibly taller/larger than MY WEALTH bar, making the order clear."
  },
  {
   "unit_id": "U4",
   "unit_kind": "change_or_rate",
   "required_candidate": true,
   "evidence_type": "endpoint_change",
   "requires": [
    "mark:MY WEALTH",
    "mark:FRIEND'S WEALTH"
   ],
   "assertion": {
    "low": "MY WEALTH",
    "low_value": 0.373,
    "high": "FRIEND'S WEALTH",
    "high_value": 1.0,
    "delta": 0.627,
    "ratio": 2.681,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "A ratio annotation, multiplier label, or text comparing bar lengths (e.g., 2.68x or about 2.7x) is visible."
  },
  {
   "unit_id": "U5",
   "unit_kind": "share_or_composition",
   "required_candidate": false,
   "evidence_type": "sector_or_segment_share",
   "requires": [
    "segment:MY WEALTH",
    "segment:FRIEND'S WEALTH"
   ],
   "assertion": {
    "segment": "MY WEALTH",
    "expected_share": 0.2717,
    "total_of": "unknown",
    "total": 1.373,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": true,
   "visual_evidence_rule_original": "A stacked bar, percentage labels, or annotation shows the combined two-bar share."
  }
 ]
}