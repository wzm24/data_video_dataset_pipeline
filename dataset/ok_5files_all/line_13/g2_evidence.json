    "strict": true,
    "tolerance": 0.02
   },
   "routes": [
    "geometry"
   ],
   "needs_review": true,
   "visual_evidence_rule_original": "A visible series trace for the first Deaths series must start near 0.75 and end near 0.64, with an overall downward displacement."
  },
  {
   "unit_id": "U2",
   "unit_kind": "trend_or_order",
   "required_candidate": true,
