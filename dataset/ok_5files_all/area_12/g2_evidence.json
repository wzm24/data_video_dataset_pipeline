     },
     {
      "mark": "battle deaths @ 2014",
      "value": 2.5
     }
    ],
    "direction": "decreasing",
    "strict": true,
    "tolerance": 0.02
   },
   "routes": [
    "geometry"
   ],
   "needs_review": true,
   "visual_evidence_rule_original": "The chart must show the series starting near 195 at 1950 and ending near 2.5 at 2014, with an overall downward envelope across the timeline."
  },
  {
   "unit_id": "U2",
   "unit_kind": "change_or_rate",
   "required_candidate": true,
   "evidence_type": "endpoint_change",
   "requires": [
    "mark:battle deaths @ 1950",
    "mark:battle deaths @ 2014"
   ],
   "assertion": {
    "low": "battle deaths @ 2014",
    "low_value": 2.5,
    "high": "battle deaths @ 1950",
    "high_value": 194.9,
    "delta": 192.4,
    "ratio": 77.96,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
