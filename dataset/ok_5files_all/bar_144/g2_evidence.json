{
 "clip_id": "bar_144",
 "family": "bar",
 "chart_form": "bar/simple",
 "measure": "mark_length",
 "policy": {
  "ratio_tolerance": 0.05,
  "value_tolerance": 0.02,
  "measured_from": "data_table + chart_spec (not from our svg)"
 },
 "evidence": [
  {
   "unit_id": "U1",
   "unit_kind": "identity_or_series",
   "required_candidate": true,
   "evidence_type": "series_identity",
   "requires": [
    "legend or series names visible"
   ],
   "assertion": {
    "series_count": 1,
    "category_count": 1,
    "tolerance": 0
   },
   "routes": [
    "structure"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "The label/entity 2021 must be visible as the only data category in the clip."
  },
  {
   "unit_id": "U2",
   "unit_kind": "key_value_endpoint",
   "required_candidate": true,
   "evidence_type": "value_at_mark",
   "requires": [
    "mark:2021 @ 2021"
   ],
   "assertion": {
    "mark": "2021 @ 2021",
    "field": "value",
    "expected": 0.125,
    "tolerance": 0.02
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "The sole data mark/label must encode or clearly correspond to 0.1250 on the relative-value scale."
  },
  {
   "unit_id": "U3",
   "unit_kind": "comparison",
   "required_candidate": true,
   "evidence_type": "pair_ratio",
   "requires": [],
   "assertion": {
    "greater": null,
    "lesser": "2021 @ 2021",
    "expected_ratio": null,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "route_note": "geometry requires the two marks to share a zero baseline; a truncated axis fails geometry but may still pass by label",
   "needs_review": false,
   "visual_evidence_rule_original": "If a whole is shown, the 2021 portion must appear/label as smaller than the remaining portion."
  },
  {
   "unit_id": "U4",
   "unit_kind": "share_or_composition",
   "required_candidate": false,
   "evidence_type": "sector_or_segment_share",
   "requires": [
    "segment:2021 @ 2021"
   ],
   "assertion": {
    "segment": "2021 @ 2021",
    "expected_share": 1.0,
    "total_of": "relative",
    "total": 0.125,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": true,
   "visual_evidence_rule_original": "The 2021 segment may be shown as one part out of eight equal parts, or labeled equivalently."
  },
  {
   "unit_id": "U5",
   "unit_kind": "trend_or_order",
   "required_candidate": false,
   "evidence_type": "monotonic_order",
   "requires": [
    "mark:2021 @ 2021"
   ],
   "assertion": {
    "sequence": [
     {
      "mark": "2021 @ 2021",
      "value": 0.125
     }
    ],
    "direction": "increasing",
    "strict": true,
    "tolerance": 0.02
   },
   "routes": [
    "geometry"
   ],
   "needs_review": true,
   "visual_evidence_rule_original": "Any trend or ranking shown must not add a second data point or category beyond 2021."
  }
 ]
}