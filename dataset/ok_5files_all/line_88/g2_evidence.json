{
 "clip_id": "line_88",
 "family": "line",
 "chart_form": "line/multi_line",
 "measure": "mark_height",
 "policy": {
  "ratio_tolerance": 0.05,
  "value_tolerance": 0.02,
  "measured_from": "data_table + chart_spec (not from our svg)"
 },
 "evidence": [
  {
   "unit_id": "U1",
   "unit_kind": "identity_or_series",
   "required_candidate": true,
   "evidence_type": "series_identity",
   "requires": [
    "legend or series names visible"
   ],
   "assertion": {
    "series_count": 2,
    "category_count": null,
    "tolerance": 0
   },
   "routes": [
    "structure"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "Both entity series must be present and readable at shared time points so a comparison can be made."
  },
  {
   "unit_id": "U2",
   "unit_kind": "comparison",
   "required_candidate": true,
   "evidence_type": "pair_ratio",
   "requires": [
    "mark:74 @ 1994",
    "mark:37 @ 1994"
   ],
   "assertion": {
    "greater": "74 @ 1994",
    "lesser": "37 @ 1994",
    "expected_ratio": 1.7255,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "route_note": "geometry requires the two marks to share a zero baseline; a truncated axis fails geometry but may still pass by label",
   "needs_review": false,
   "visual_evidence_rule_original": "The chart must show both series at 1994, 1996, and 1998 so their small separation can be read."
  },
  {
   "unit_id": "U3",
   "unit_kind": "trend_or_order",
   "required_candidate": false,
   "evidence_type": "monotonic_order",
   "requires": [
    "mark:74 @ 2000",
    "mark:37 @ 2000",
    "mark:74 @ 2008",
    "mark:37 @ 2008"
   ],
   "assertion": {
    "sequence": [
     {
      "mark": "74 @ 2000",
      "value": 78.1628
     },
     {
      "mark": "37 @ 2000",
      "value": 71.1628
     },
     {
      "mark": "74 @ 2008",
      "value": 11.1628
     },
     {
      "mark": "37 @ 2008",
      "value": 11.1628
     }
    ],
    "direction": "decreasing",
    "strict": true,
    "tolerance": 0.02
   },
   "routes": [
    "geometry"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "The chart must show the 2000 high and 2008 low for both series, or make that shared rise-and-fall traceable."
  },
  {
   "unit_id": "U4",
   "unit_kind": "comparison",
   "required_candidate": true,
   "evidence_type": "pair_ratio",
   "requires": [
    "mark:74 @ x_px=1119.4",
    "mark:37 @ x_px=1119.4"
   ],
   "assertion": {
    "greater": "74 @ x_px=1119.4",
    "lesser": "37 @ x_px=1119.4",
    "expected_ratio": 1.9695,
    "tolerance": 0.05
   },
   "routes": [
    "geometry",
    "label"
   ],
   "route_note": "geometry requires the two marks to share a zero baseline; a truncated axis fails geometry but may still pass by label",
   "needs_review": false,
   "visual_evidence_rule_original": "The final point for both series must be visible or labeled so the large gap can be read."
  },
  {
   "unit_id": "U5",
   "unit_kind": "threshold_or_crossing",
   "required_candidate": false,
   "evidence_type": "series_crossing",
   "requires": [
    "mark:37 @ 2012",
    "mark:74 @ 2012"
   ],
   "assertion": {
    "at": "2012",
    "above": "37",
    "above_value": 23.1628,
    "below": "74",
    "below_value": 16.1628,
    "direction": "above at this x",
    "tolerance": 0.02
   },
   "routes": [
    "geometry",
    "label"
   ],
   "needs_review": false,
   "visual_evidence_rule_original": "The chart must show the 2012 and 2016 values for both series and the final point so the sign of the gap can be read."
  }
 ]
}